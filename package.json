{
  "name": "core",
  "version": "0.1.0",
  "description": "The project file format, operations layer and undo history shared by the graph / work / slides / chat tools.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./schema": "./src/schema.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "src",
    "fixtures"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.6.3",
    "zod": "^4.6.7"
  }
}
