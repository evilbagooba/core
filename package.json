{
  "name": "tako",
  "version": "0.3.0",
  "description": "The tako project format, its operations layer, and the hub that lets the graph / work / slides / chat tools share projects.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./hub": "./src/hub/server.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "src",
    "fixtures",
    "bin"
  ],
  "scripts": {
    "start": "node bin/tako.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.6.3",
    "zod": "^4.6.7"
  },
  "bin": {
    "tako": "./bin/tako.mjs"
  },
  "dependencies": {
    "tsx": "^4.20.6"
  }
}
